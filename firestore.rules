// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: alerts
// Document ID: auto-generated by Firestore Admin SDK
// Fields:
//   - receivedAt:     timestamp  (required) - server timestamp when alert was received
//   - text:           string     (required, max 20000 chars) - original alert text
//   - enriched:       bool       (required) - whether enrichment ran
//   - enrichmentData: map | null (optional) - Gemini/TradingView enriched object
//   - tokenUsage:     map | null (optional) - token usage breakdown
//   - deliveryResults: list      (required) - per-channel SendResult objects
//   - source:         string     (required) - always "webhook"
//   - useTradingViewData: bool   (required) - request query flag
//
// Collection: alertAcknowledgements
// Document ID: <alertId>__<sha256(chatId).slice(0, 32)>
// Fields:
//   - alertId:        string    (required) - FK to alerts/<id>
//   - chatId:         string    (required) - sensitive, server-side only, never returned
//   - chatIdHash:     string    (required) - SHA-256 hex for safe aggregation
//   - action:         string    (required) - took_trade | skipped | no_trade_no_signal | snoozed
//   - notes:          string    (optional, max 280 chars)
//   - symbol:         string    (optional) - uppercase symbol for outcome join
//   - exchange:       string    (optional) - uppercase exchange for outcome join
//   - acknowledgedAt: timestamp (required) - server timestamp on first write
//   - updatedAt:      timestamp (required) - server timestamp on every write
//   - expiresAt:      timestamp (required) - acknowledgedAt + ALERT_STORAGE_RETENTION_DAYS
//
// Access pattern: server-side Admin SDK writes only. No client SDK used.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All writes are performed exclusively by the firebase-admin SDK on the server.
    // The Admin SDK bypasses security rules, so these rules only guard against
    // any accidental client-side access. Deny everything at the client level.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
