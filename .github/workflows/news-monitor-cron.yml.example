# Example GitHub Actions Cron Workflow for News Monitoring
# 
# This workflow demonstrates how to schedule periodic news monitoring 
# across your configured crypto and stock symbols.
#
# Usage:
# 1. Copy this file to your actual workflow: cp .github/workflows/news-monitor-cron.yml.example .github/workflows/news-monitor-cron.yml
# 2. Configure repository secrets in GitHub (Settings -> Secrets and variables -> Actions):
#    - WEBHOOK_API_KEY: API key matching the server's WEBHOOK_API_KEY environment variable
#    - NEWS_MONITOR_BASE_URL: Base URL of your deployed bot (e.g. https://cabros-bot-production.up.railway.app)
# 3. Adjust schedule and options as needed
# 4. Commit and push to enable the workflow
#
# Security Note: Never include API keys in URLs, query strings, or logs. Pass WEBHOOK_API_KEY strictly in the x-api-key header.

name: News Monitor - Scheduled Analysis

# Run every 4 hours (typical market analysis frequency)
on:
  schedule:
    - cron: '0 */4 * * *'
  # Allow manual triggering with optional dry-run
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'Dry run (analyze without sending alerts)'
        required: false
        type: boolean
        default: false

jobs:
  news_monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    
    steps:
      - name: Call News Monitor API
        run: |
          # Use server-side configured symbols by default (NEWS_SYMBOLS_CRYPTO and NEWS_SYMBOLS_STOCKS)
          # Pass x-api-key header securely from GitHub secrets
          DRY_RUN="${{ inputs.dry_run || 'false' }}"
          
          if [ "$DRY_RUN" = "true" ]; then
            PAYLOAD='{"dryRun":true}'
          else
            PAYLOAD='{}'
          fi
          
          # Optional per-run symbol overrides example:
          # PAYLOAD='{"crypto":["BTCUSDT","ETHUSDT"],"stocks":["NVDA","AAPL"],"dryRun":false}'
          
          curl -f -sS -X POST \
            -H "Content-Type: application/json" \
            -H "x-api-key: ${{ secrets.WEBHOOK_API_KEY }}" \
            -d "$PAYLOAD" \
            "${{ secrets.NEWS_MONITOR_BASE_URL }}/api/news-monitor"
        env:
          # Webhook API key passed safely to curl via secrets
          WEBHOOK_API_KEY: ${{ secrets.WEBHOOK_API_KEY }}
          NEWS_MONITOR_BASE_URL: ${{ secrets.NEWS_MONITOR_BASE_URL }}
        
      - name: Log Analysis Results
        if: failure()
        run: echo "News monitoring failed. Check logs above for details."

  # Optional: Send summary notification on failures
  notify_on_failure:
    needs: news_monitor
    runs-on: ubuntu-latest
    if: failure()
    
    steps:
      - name: Send failure notification
        run: |
          # Uncomment to enable notifications:
          # - Set up GitHub email notifications
          # - Or integrate with external notification service (Slack, Discord, PagerDuty, etc.)
          echo "News monitoring workflow failed. Review logs in Actions tab."

# Secrets Configuration:
# Add these in GitHub Repository Settings -> Secrets and variables -> Actions:
# - WEBHOOK_API_KEY: The API key secret required by validateApiKey (x-api-key header)
# - NEWS_MONITOR_BASE_URL: Base URL of your deployment (e.g. https://cabros-bot-production.up.railway.app)

# Customization Options:
# - Adjust cron schedule: https://crontab.guru/
# - Test runs safely with workflow_dispatch dry_run=true
# - To override server-configured symbols per run, customize PAYLOAD as shown above

