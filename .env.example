# ============================================================================
# Cabros Crypto Bot - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# See README.md for detailed configuration guide
# ============================================================================

# ============================================================================
# REQUIRED: Core Bot Configuration
# ============================================================================

# Telegram bot token (required only when ENABLE_TELEGRAM_BOT=true outside PR previews)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID where bot sends alerts (use /start to find your chat ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram forum topic routing (message_thread_id) by alert source/category.
# Comma-separated pairs 'category:threadId' or JSON string format {"webhook-signal":101,"market-scanner":202}.
# Thread ID 0 or null routes to the chat's General topic. Supported categories include:
# webhook-alert, webhook-signal, expanded-analysis, market-scanner, news-monitor, scanner-preset, tradingview-analysis, generic-message, default.
# TELEGRAM_TOPIC_ROUTES=webhook-signal:101,market-scanner:202,news-monitor:303,default:0

# Enable Telegram bot (true or false)
ENABLE_TELEGRAM_BOT=true

# ============================================================================
# OPTIONAL: Security and API Authentication
# ============================================================================

# API Key to secure all /api webhook endpoints (REQUIRED in production).
# In production-like environments (NODE_ENV=production, Render, Vercel, Railway),
# /api/webhook/* endpoints fail-closed with 503 if this key is unset.
# When configured, requests must include the header: x-api-key: your_key_here
# or the legacy query parameter: api-key=your_key_here
# WEBHOOK_API_KEY=your_webhook_api_key_here

# Optional comma-separated list of additional allowed browser origins for CORS.
# Default allowlist includes https://cabros-bot.web.app, https://cabros-bot.firebaseapp.com,
# https://cabros-bot-production.up.railway.app, and localhost/127.0.0.1 on any port.
# Classified as environment-only for Remote Config parity (security origin control; excluded from Remote Config template).
# CORS_ALLOWED_ORIGINS=https://cabros-bot-staging.up.railway.app,https://admin.custom-domain.com

# ============================================================================
# OPTIONAL: WhatsApp Alerts (GreenAPI Integration)
# ============================================================================

# Enable WhatsApp alerts (default: false)
ENABLE_WHATSAPP_ALERTS=false

# GreenAPI endpoint URL (e.g., https://xxxx.api.green-api.com/<instance-id>/)
WHATSAPP_API_URL=your_whatsapp_api_url

# GreenAPI API key for authentication
WHATSAPP_API_KEY=your_whatsapp_api_key

# WhatsApp chat/group ID (format: 120363xxxxx@g.us)
WHATSAPP_CHAT_ID=your_whatsapp_chat_id_here

# WhatsApp preview/PR chat/group ID (optional)
# When IS_PULL_REQUEST=true, messages are sent here instead of WHATSAPP_CHAT_ID
WHATSAPP_PREVIEW_CHAT_ID=your_whatsapp_preview_chat_id_here

# Enable WhatsApp inbound commands bridge (!precio, !help via GreenAPI receiveNotification)
ENABLE_WHATSAPP_COMMANDS=false

# Comma-separated list of WhatsApp chat/group IDs allowed to execute commands (e.g., 120363025492938@g.us,120363099999999@g.us)
WHATSAPP_COMMAND_CHAT_IDS=120363025492938@g.us

# Polling interval in ms for WhatsApp inbound commands (default: 3000)
WHATSAPP_COMMAND_POLL_INTERVAL_MS=3000

# ============================================================================
# OPTIONAL: Discord Alerts (Webhook Integration)
# ============================================================================

# Enable Discord alerts (default: false)
ENABLE_DISCORD_ALERTS=false

# Discord webhook URL (e.g., https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Discord retry controls (defaults: 2 retries, 500ms fallback, 5000ms max delay, 10000ms total wait)
DISCORD_MAX_RETRIES=2
DISCORD_FALLBACK_RETRY_DELAY_MS=500
DISCORD_MAX_RETRY_DELAY_MS=5000
DISCORD_MAX_TOTAL_RETRY_WAIT_MS=10000

# ============================================================================
# OPTIONAL: Notification Dead-Letter & Redrive
# ============================================================================

# Enable dead-letter queueing and automatic redrive for failed notification channels (default: false)
ENABLE_NOTIFICATION_REDRIVE=false

# Worker role for executing redrive sweeps: web (default), worker, or disabled
NOTIFICATION_REDRIVE_WORKER_ROLE=web

# Sweep interval in milliseconds between background redrive attempts (default: 60000, min: 1000, max: 3600000)
NOTIFICATION_REDRIVE_INTERVAL_MS=60000

# Maximum candidate dead-letter records to process per redrive sweep (default: 50, min: 1, max: 500)
NOTIFICATION_REDRIVE_BATCH_LIMIT=50

# Maximum redrive attempts per dead-letter record before terminal exhaustion (default: 5, min: 1, max: 20)
NOTIFICATION_REDRIVE_MAX_ATTEMPTS=5

# Maximum age in milliseconds for dead-letter records before expiration (default: 3600000, min: 60000, max: 86400000)
# Firestore-backed `notificationDeadLetters` documents use this value for `expiresAt`.
NOTIFICATION_REDRIVE_MAX_AGE_MS=3600000

# Cooldown between admin notifications when all channels are disabled in milliseconds (default: 300000, min: 1000, max: 86400000)
ZERO_CHANNEL_ALERT_COOLDOWN_MS=300000

# Declare intentional API-only mode without notification delivery (suppresses zero-channel paging & dead-lettering, default: false)
ENABLE_API_ONLY_MODE=false

# Enable the opt-in POST /api/ops/test-alert canary endpoint for post-deploy channel-delivery verification (default: false).
# When enabled, the endpoint accepts WEBHOOK_API_KEY and sends one synthetic alert (source: 'canary') through
# notificationManager.sendToChannels() / sendToAll() with no Gemini/TradingView/Langfuse enrichment.
# Keep disabled in production unless intentionally smoke-testing channels.
ENABLE_CANARY_ENDPOINT=false

# ============================================================================
# OPTIONAL: AI Grounding (Gemini GoogleSearch Enrichment)
# ============================================================================

# Enable Gemini-based alert enrichment (default: false)
ENABLE_GEMINI_GROUNDING=false

# Google API key with Generative AI enabled (get from Google AI Studio)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Primary provider used by grounding and secondary LLM enrichment.
# Supported values include gemini, azure, openrouter, and cloudflare.
MODEL_PROVIDER=gemini

# Primary Gemini model used when MODEL_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.5-flash

# Fallback Gemini model for transient primary-model failures
GEMINI_MODEL_NAME_FALLBACK=gemini-2.5-flash-lite

# Grounding model when FORCE_BRAVE_SEARCH=false (default: gemini-2.5-flash)
GROUNDING_MODEL_NAME=gemini-2.5-flash

# Maximum grounded sources included per alert (default: 3)
GROUNDING_MAX_SOURCES=3

# Grounding request timeout in milliseconds (default: 30000)
GROUNDING_TIMEOUT_MS=30000

# Maximum alert text length sent to grounding prompts (default: 2000)
GROUNDING_MAX_LENGTH=2000

# Reuse equity grounding search context within this window; 0 disables it (default: 0)
ALERT_GROUNDING_COALESCE_MS=0

# Optional Brave Search fallback or forced-search provider
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
FORCE_BRAVE_SEARCH=false

# Optional OpenRouter provider credentials and model
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Enable model metadata footer in enriched alerts (default: true)
ENABLE_MESSAGE_FOOTER_METADATA=true

# ==========================================================================
# OPTIONAL: Langfuse Prompt Management
# ==========================================================================

# Fetch runtime prompts from Langfuse instead of local defaults (default: false)
ENABLE_LANGFUSE_PROMPTS=false

# Langfuse project credentials (required when ENABLE_LANGFUSE_PROMPTS=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse region or self-hosted base URL (default: https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Prompt label to fetch (default: latest in dev/test, production in prod-like envs)
LANGFUSE_PROMPT_LABEL=latest

# SDK cache TTL in seconds for prompt fetches (default: 0 for latest, 60 for production)
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=0

# Optional local prompt overrides; unset values use the versioned files under src/services/prompts/defaults/.
# SEARCH_QUERY_PROMPT=
# GEMINI_SYSTEM_PROMPT=
# ALERT_ENRICHMENT_SYSTEM_PROMPT=
# NEWS_ANALYSIS_SYSTEM_PROMPT=
# CONFIDENCE_ENRICHMENT_SYSTEM_PROMPT=

# ============================================================================
# OPTIONAL: TradingView MCP Enrichment (Webhook Signals)
# ============================================================================

# Enable MCP-based technical enrichment for TradingView-like alerts
# Example input: BTCUSDT(240) pasó a señal de VENTA
# Runtime note: request must include /api/webhook/alert?useTradingViewData=true
ENABLE_TRADINGVIEW_MCP_ENRICHMENT=false

# MCP server endpoint (Streamable HTTP)
TRADINGVIEW_MCP_URL=https://tradingview-mcp-yp6b.onrender.com/mcp

# Request timeout per MCP call in milliseconds (integer 1000-120000; invalid values use 12000)
TRADINGVIEW_MCP_TIMEOUT_MS=12000

# Total synchronous MCP enrichment budget in milliseconds (integer 1000-120000; invalid values use 12000)
TRADINGVIEW_MCP_ENRICHMENT_BUDGET_MS=12000

# Retry attempts for MCP calls (integer 1-5; invalid values use 3)
TRADINGVIEW_MCP_MAX_RETRIES=3

# Defaults used when signal does not include exchange/timeframe
TRADINGVIEW_MCP_DEFAULT_EXCHANGE=BINANCE
TRADINGVIEW_MCP_DEFAULT_TIMEFRAME=1h

# Maximum TradingView MCP consecutive failures before opening circuit breaker and paging operators (default: 5, min: 1, max: 100)
TRADINGVIEW_MCP_BREAKER_FAILURE_THRESHOLD=5

# Circuit breaker open cooldown in milliseconds before half-open probe (default: 600000, min: 1000, max: 86400000)
TRADINGVIEW_MCP_BREAKER_COOLDOWN_MS=600000

# Operator degradation paging cooldown in milliseconds between admin notifications (default: 3600000, min: 1000, max: 86400000)
TRADINGVIEW_MCP_PAGE_COOLDOWN_MS=3600000

# Enable volume breakout validation for TradingView alerts (default: false)
ENABLE_TRADINGVIEW_VOLUME_CONFIRMATION=false

# Enable combined_analysis confluence enrichment for TradingView webhook alerts (default: false)
ENABLE_TRADINGVIEW_CONFLUENCE_ENRICHMENT=false

# Also call multi_timeframe_analysis during confluence enrichment (default: false)
ENABLE_TRADINGVIEW_CONFLUENCE_MULTI_TIMEFRAME=false

# Enable rendering higher-timeframe trend alignment on enriched webhook alerts (default: true)
ENABLE_ALERT_HTF_RENDER=true

# Suppress duplicate channel delivery for the same exchange/symbol/timeframe/side signal within its
# cooldown window; suppressed alerts are still persisted with a suppressedRepeat marker (default: false)
ENABLE_ALERT_SIGNAL_REPEAT_SUPPRESSION=false

# Cooldown length in alert-timeframe bars for same-signal repeat suppression (default: 1, min: 1, max: 10)
ALERT_SIGNAL_COOLDOWN_BARS=1

# Fallback symbols for /api/webhook/expanded-analysis-alert using EXCHANGE:SYMBOL format (comma-separated)
# Example: BINANCE:BTCUSDT,NASDAQ:NVDA
EXPANDED_ANALYSIS_ALERT_SYMBOLS=BINANCE:BTCUSDT,NASDAQ:NVDA

# Total analysis deadline for /api/webhook/expanded-analysis-alert in milliseconds (default: 60000)
EXPANDED_ANALYSIS_ALERT_TIMEOUT_MS=60000

# Maximum concurrent expanded-analysis MCP calls (default: 3, valid range: 1-10)
EXPANDED_ANALYSIS_ALERT_CONCURRENCY=3

# ============================================================================
# OPTIONAL: Admin Notifications
# ============================================================================

# Chat ID for admin notifications and deployment alerts (optional)
TELEGRAM_ADMIN_NOTIFICATIONS_CHAT_ID=your_admin_chat_id_here

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================

# HTTP server port (default: 80)
PORT=80

# Maximum graceful shutdown budget in milliseconds (default: 10000, hard cap: 30000)
SHUTDOWN_TIMEOUT_MS=10000

# Log level for console output (debug, info, warn, error, silent)
# Defaults to debug in development and info in production
LOG_LEVEL=info

# Global API rate-limit window in milliseconds (default: 900000 / 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Global API rate-limit maximum requests per window (default: 100)
RATE_LIMIT_MAX=100

# Optional structured-log service name (default: cabros-bot)
SERVICE_NAME=cabros-bot

# Render.com deployment flag (set automatically by Render)
RENDER=false

# Trusted proxy configuration for Express rate limiting behind reverse proxies.
# Supported values: true (trust all), false (ignore X-Forwarded-For; direct deployment default),
# 1 (trust 1 hop; Render/Vercel default), or a subnet string (e.g., loopback, 10.0.0.0/8).
# TRUST_PROXY=1

# Maximum API requests per client per window (default: 100; invalid values use the default)
# RATE_LIMIT_MAX=100

# API rate-limit window in milliseconds (default: 900000; invalid values use the default)
# RATE_LIMIT_WINDOW_MS=900000

# Render preview environment flag (set automatically by Render)
IS_PULL_REQUEST=false

# Vercel system variables are injected automatically in Vercel deployments.
# VERCEL=1
# VERCEL_ENV=development
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_REPO_OWNER=
# VERCEL_GIT_REPO_OWNER_NAME=
# VERCEL_GIT_REPO_SLUG=

# Railway system variables are injected automatically in Railway deployments.
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_GIT_PULL_REQUEST_NUMBER=
# RAILWAY_GIT_COMMIT_SHA=
# RAILWAY_GIT_REPO_OWNER=
# RAILWAY_GIT_REPO_NAME=

# ============================================================================
# OPTIONAL: News Monitoring Feature (003-news-monitor)
# ============================================================================

# Enable news monitoring endpoint (default: false)
ENABLE_NEWS_MONITOR=false

# Enable news monitoring endpoint in test mode (default: false)
# In test mode, alerts are generated without real news data
ENABLE_NEWS_MONITOR_TEST_MODE=false

# Default crypto symbols if not provided in request (comma-separated)
# Example: BTCUSDT,ETHUSD,BNBUSDT
NEWS_SYMBOLS_CRYPTO=BTCUSDT,ETHUSD,BNBUSDT

# Default stock symbols if not provided in request (comma-separated)
# Example: NVDA,MSFT,AAPL
NEWS_SYMBOLS_STOCKS=NVDA,MSFT,AAPL

# Confidence score threshold for sending alerts (default: 0.7, range: 0.0-1.0)
# Alerts with confidence below this threshold are filtered out
NEWS_ALERT_THRESHOLD=0.7

# Cache time-to-live for deduplication (default: 6 hours)
# Same (symbol, event_category) pair within TTL will be cached
NEWS_CACHE_TTL_HOURS=6

# Enable Firestore-backed news deduplication (default: false; fail-open memory fallback)
ENABLE_NEWS_MONITOR_PERSISTENT_DEDUP=false

# Per-symbol analysis timeout in milliseconds (default: 30000 ms)
# Each symbol has up to this long to complete analysis
NEWS_TIMEOUT_MS=30000

# Max concurrent Gemini-backed symbol analyses.
# Production policy: keep this bounded at 3 to reduce quota bursts.
# Unset preserves legacy full fan-out for backward compatibility.
NEWS_GEMINI_CONCURRENCY=3

# Per-symbol retries for Gemini 429 RESOURCE_EXHAUSTED errors (default: 2)
NEWS_GEMINI_QUOTA_MAX_RETRIES=2

# Base exponential backoff in ms when Gemini does not provide retry metadata (default: 1000)
NEWS_GEMINI_QUOTA_RETRY_BASE_MS=1000

# ============================================================================
# OPTIONAL: Binance Price Integration (News Monitoring)
# ============================================================================

# Enable Binance crypto price fetching (default: false)
# When enabled, fetches real-time prices from Binance API (~5s timeout)
# Falls back to Gemini GoogleSearch if Binance fails or times out
ENABLE_BINANCE_PRICE_CHECK=false

# Binance price request timeout in milliseconds (default: 5000)
BINANCE_FETCH_TIMEOUT_MS=5000

# Base URL for Binance market-data calls (klines, avgPrice, 24h ticker).
# Use this when the default host is geo-blocked in your deployment region
# (e.g. Railway production receives HTTP 451 from api.binance.com). Set to
# an unrestricted alternative that supports market-data endpoints such as
# https://api1.binance.com, https://api2.binance.com, https://api3.binance.com,
# or https://data-api.binance.vision. Must be an http(s) URL.
# Affects: SignalOutcomeService sweep + entry fallback, BinanceOrderService
# live client, news-monitor price fallback, and the /precio Telegram command.
# Defaults to https://api.binance.com when unset (preserves existing behavior).
BINANCE_DATA_BASE_URL=https://api.binance.com

# ============================================================================
# OPTIONAL: Binance Spot Order Execution (Operator-Only)
# ============================================================================

# Keep disabled until testnet validation is complete (default: false)
ENABLE_BINANCE_TRADING=false

# Binance API credentials. Use Spot trading permission only; never enable withdrawals.
BINANCE_API_KEY=your_binance_spot_api_key_here
BINANCE_API_SECRET=your_binance_spot_api_secret_here

# Binance trading environment: testnet | demo | live
# testnet: https://testnet.binance.vision — independent sandbox, may differ from production filters
# demo: https://demo-api.binance.com — mirrors production market data and filters exactly (recommended for pre-live validation)
# live: https://api.binance.com — real funds; only enable after demo validation
BINANCE_TRADING_ENV=testnet

# Comma-separated allow-list of symbols accepted by POST /api/trading/binance/orders
BINANCE_TRADING_ALLOWED_SYMBOLS=BTCUSDT

# Maximum order notional in quote asset for live and dry-run validation
BINANCE_TRADING_MAX_NOTIONAL=1000

# Signed Binance request timeout in milliseconds (default: 10000, maximum: 30000)
BINANCE_TRADING_TIMEOUT_MS=10000

# Enable structured Firestore audit logging for Binance order mutations (default: false)
ENABLE_BINANCE_ORDER_AUDIT=false

# Audit log retention in days before Firestore TTL expiry (default: 30, range: 1-365)
BINANCE_ORDER_AUDIT_RETENTION_DAYS=30

# ============================================================================
# OPTIONAL: Secondary LLM Enrichment (News Monitoring)
# ============================================================================

# Enable optional secondary LLM enrichment for news alerts (default: false)
# Refines confidence scores using conservative strategy: min(Gemini, LLM)
# Prevents false positives from LLM hallucination
ENABLE_LLM_ALERT_ENRICHMENT=false

# Azure AI Inference endpoint URL
# Example: https://models.github.ai/inference or https://your-azure-instance.inference.ai.azure.com
AZURE_LLM_ENDPOINT=your_azure_or_github_models_endpoint_here

# Azure AI Inference API key
# Use Azure API key or GitHub Personal Access Token (PAT)
AZURE_LLM_KEY=your_azure_api_key_or_github_pat_here

# Azure AI LLM model deployment name
# Example: openai/gpt-5-mini (GitHub Models) or gpt-4o (Azure)
AZURE_LLM_MODEL=your_model_name_here

# ============================================================================
# OPTIONAL: Cloudflare AI Gateway LLM Provider
# ============================================================================
# Replaces or supplements provider-specific clients with the OpenAI SDK
# pointed at Cloudflare AI Gateway's OpenAI-compatible endpoint.
# Set MODEL_PROVIDER=cloudflare to use this provider as the primary LLM.
# Expose Cloudflare AI Gateway readiness in status/capabilities only; set MODEL_PROVIDER=cloudflare for runtime routing.
ENABLE_CLOUDFLARE_AIG=false
#
# Cloudflare AI Gateway token (API key)
# CF_AIG_TOKEN=your_cloudflare_ai_gateway_token_here
#
# OpenAI-compatible base URL for Cloudflare AI Gateway
# CF_AIG_BASE_URL=https://gateway.ai.cloudflare.com/v1/your-account-tag/default/compat
#
# Default model served through the gateway (e.g., google-ai-studio/gemini-2.5-flash)
# CF_AIG_MODEL=google-ai-studio/gemini-2.5-flash

# ============================================================================
# URL Shortening for WhatsApp (Optional)
# ============================================================================
URL_SHORTENER_SERVICE=picsee
PICSEE_API_KEY=
CUTTLY_API_KEY=
# TinyURL does not require a credential.
# Bitly, reurl, and Pixnet0rz.tw are not supported by the runtime.
# Unsupported compatibility keys:
# BITLY_ACCESS_TOKEN=
# BITLY_API_KEY=
# REURL_API_KEY=

# ============================================================================
# OPTIONAL: TradingView Market Scanner Alerts
# ============================================================================

# Enable TradingView Market Scanner endpoint (default: false)
ENABLE_MARKET_SCANNER=false

# Default exchange when not provided in request
MARKET_SCANNER_DEFAULT_EXCHANGE=BINANCE

# Timeout in milliseconds for scanner webhook process (default: 90000, max: 120000)
MARKET_SCANNER_TIMEOUT_MS=90000

# Enable independent Firestore persistence for scanner presets (default: false)
# When disabled, presets use an in-memory fallback and do not survive restarts.
# The API and /api/status report the effective durable/ephemeral storage mode.
ENABLE_FIRESTORE_SCANNER_PRESETS=false

# Enable recurring execution of scheduled scanner presets (default: false)
ENABLE_SCANNER_PRESET_SCHEDULER=false
# Scheduler worker role: web (default), worker, or disabled
SCANNER_PRESET_SCHEDULER_WORKER_ROLE=web
# Scheduler sweep interval in milliseconds (default: 60000, valid: 1000-3600000)
SCANNER_PRESET_SCHEDULER_INTERVAL_MS=60000
# Maximum due presets scanned and executed per sweep (default: 50, valid: 1-500)
SCANNER_PRESET_SCHEDULER_BATCH_LIMIT=50
# Distributed concurrency lock lease duration in milliseconds (default: 120000, valid: 10000-600000)
SCANNER_PRESET_SCHEDULER_LEASE_MS=120000

# ============================================================================
# News Monitor Scheduler (Built-in Recurring Sweeps)
# ============================================================================
# Enable recurring execution of news-monitor sweeps in-app (default: false)
ENABLE_NEWS_MONITOR_SCHEDULER=false
# Scheduler worker role: web (default), worker, or disabled
NEWS_MONITOR_SCHEDULER_WORKER_ROLE=web
# Scheduler sweep interval in milliseconds (default: 300000, valid: 10000-3600000)
NEWS_MONITOR_SCHEDULER_INTERVAL_MS=300000
# Maximum default news-monitor symbols to process per sweep (default: 50, valid: 1-500)
NEWS_MONITOR_SCHEDULER_BATCH_LIMIT=50
# Distributed concurrency lock lease duration in milliseconds (default: 120000, valid: 10000-600000)
NEWS_MONITOR_SCHEDULER_LEASE_MS=120000
# Per-sweep execution deadline in milliseconds (default: 90000, valid: 1000-600000)
NEWS_MONITOR_SCHEDULER_TIMEOUT_MS=90000

# ============================================================================
# Sentry Monitoring Configuration (Optional)
# ============================================================================
ENABLE_SENTRY=false # Enable Sentry error reporting (`true` or `false`, default: `false`)
SENTRY_DSN=your_sentry_dsn_here # Sentry Data Source Name (DSN) from your Sentry project settings
SENTRY_SEND_ALERT_CONTENT=true # Include alert text in error events (`true` or `false`, default: `true`)
SENTRY_SAMPLE_RATE_ERRORS=1.0 # Error sample rate from 0.0 to 1.0 (default: `1.0` = 100% of errors)
SENTRY_TRACES_SAMPLE_RATE=0.1 # Trace sample rate from 0.0 to 1.0 (leave empty/unset to disable tracing entirely)
SENTRY_PROFILE_SESSION_SAMPLE_RATE= # Profiling session sample rate from 0.0 to 1.0 (leave unset to disable profiling; requires SENTRY_TRACES_SAMPLE_RATE to be set)
SENTRY_CONSOLE_LOG_LEVELS=warn,error # Comma-separated console levels captured as Sentry Logs
SENTRY_ENVIRONMENT=development # Explicit environment tag (`production`, `preview`, `development`). Auto-derived if not set
SENTRY_RELEASE=local # Explicit release tag (e.g., `v1.2.3`). Auto-derived from git commit if not set
ENABLE_SENTRY_DEBUG_ROUTE=false # Mount /debug-sentry only for explicit local/manual validation (default: false)
# ============================================================================

# ============================================================================
# OPTIONAL: Firestore Alert Storage (006-firestore-alert-storage)
# ============================================================================

# Enable storing every /api/webhook/alert payload in Cloud Firestore (default: false)
# When enabled, each alert is persisted to the `alerts` collection after delivery.
# Failure to write to Firestore never blocks or fails alert delivery (fail-open).
ENABLE_FIRESTORE_ALERT_STORAGE=false
# Retain stored alerts/replay audit records for this many days (valid range: 1-3650, default: 90).
# Alerts, replay audits, and terminal TradingView jobs receive an expiresAt field; run ops/configure-firestore-alert-retention.sh once per project to backfill legacy records and enable Firestore TTL deletion.
ALERT_STORAGE_RETENTION_DAYS=90

# Enable storing async TradingView scanner/analysis jobs in Cloud Firestore (default: false)
# When enabled, job execution state is persisted to the `jobs` collection.
ENABLE_FIRESTORE_JOB_STORAGE=false

# Keep async jobs in-process (local), enqueue them for the Render worker with Redis (render-worker),
# or poll queued jobs directly from Firestore without Redis (firestore-poller).
# render-worker requires REDIS_URL and durable Firestore job storage.
# firestore-poller requires durable Firestore job storage.
JOB_EXECUTION_MODE=local
# Polling interval in milliseconds for firestore-poller mode (valid range: 1000-300000, default: 15000)
JOB_POLL_INTERVAL_MS=15000
REDIS_URL=
JOB_QUEUE_ATTEMPTS=5
JOB_QUEUE_BACKOFF_MS=30000
JOB_QUEUE_CONCURRENCY=1
JOB_QUEUE_CLAIM_LEASE_MS=60000
JOB_QUEUE_CONNECT_TIMEOUT_MS=5000

# Enable durable webhook idempotency storage in Cloud Firestore (default: false)
# When enabled, idempotency reservations and cached responses are stored in `idempotency_keys` collection.
ENABLE_FIRESTORE_IDEMPOTENCY=false
# Deprecated compatibility alias; prefer ENABLE_FIRESTORE_IDEMPOTENCY.
# ENABLE_FIRESTORE_IDEMPOTENCY_STORAGE=false

# Completed idempotency response retention in milliseconds (default: 300000 / 5 minutes)
# Documents in the `idempotency_keys` collection carry an `expiresAt` field and are
# cleaned up by Firestore native TTL. Run ops/configure-operational-collection-retention.sh
# once per project to enable the TTL policy (and optionally backfill legacy documents).
WEBHOOK_IDEMPOTENCY_TTL_MS=300000

# News-monitor persistent dedup TTL — mirrors NEWS_CACHE_TTL_HOURS (default: 6 hours).
# Documents in `news-monitor-dedup` carry an `expiresAt` field and are cleaned up by
# Firestore native TTL. Run ops/configure-operational-collection-retention.sh once per
# project to enable the TTL policy.

# Enable signal outcome tracking (default: false)
ENABLE_SIGNAL_OUTCOME_TRACKING=false
# Scheduler role: web (legacy/local timer), worker (dedicated Render worker), or disabled.
SIGNAL_OUTCOME_WORKER_ROLE=web

# Optional Twelve Data evaluation for NASDAQ/BATS/NYSE/AMEX/NYSE ARCA/FX_IDC/SPCFD signal outcomes (default: false)
# Requires a provider API key; leave disabled until plan limits and market-data licensing are confirmed.
ENABLE_EQUITY_MARKET_DATA=false
EQUITY_MARKET_DATA_PROVIDER=twelve-data
TWELVE_DATA_API_KEY=your_twelve_data_api_key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
EQUITY_MARKET_DATA_TIMEOUT_MS=5000
# Maximum equity market data requests per minute for rate-limit pacing (default: 8)
EQUITY_MARKET_DATA_RPM=8
# Provider-specific alias for EQUITY_MARKET_DATA_RPM (default: 8)
# TWELVE_DATA_RPM=8

# Signal Outcome Evaluation Worker Configuration
# Environment-only startup cadence in milliseconds (default: 300000 / 5 minutes).
# This key is intentionally excluded from Firebase Remote Config because the timer
# is created once during process startup.
SIGNAL_OUTCOME_EVALUATION_INTERVAL_MS=300000
# Maximum pending signals to scan per evaluation sweep (default: 50)
SIGNAL_OUTCOME_EVALUATION_BATCH_LIMIT=50
# Maximum duration budget per evaluation sweep in milliseconds (default: 30000 / 30 seconds)
SIGNAL_OUTCOME_EVALUATION_MAX_DURATION_MS=30000
# Maximum retry attempts for transient market data failures before signal outcome window is marked unavailable (default: 3)
SIGNAL_OUTCOME_MAX_RETRY_ATTEMPTS=3
# Maximum age in milliseconds for retrying transient market data failures (default: 604800000 / 7 days)
SIGNAL_OUTCOME_MAX_RETRY_AGE_MS=604800000
# Retention window in days for tradingSignalOutcomes documents before expiration and cleanup (valid range: 1-3650, integer, default: 365).
SIGNAL_OUTCOME_RETENTION_DAYS=365
# Deprecated compatibility alias; prefer SIGNAL_OUTCOME_EVALUATION_INTERVAL_MS.
# SIGNAL_OUTCOME_EVALUATION_CADENCE_MS=300000

# Async callback delivery retry backoff in milliseconds (default: 1000)
JOB_CALLBACK_RETRY_DELAY_MS=1000

# Optional HMAC secret for async callback signatures; keep empty unless explicitly configured.
# JOB_CALLBACK_SIGNING_SECRET=

# Security overrides for local callback testing only; keep both false in production.
ALLOW_HTTP_CALLBACKS=false
ALLOW_PRIVATE_CALLBACKS=false

# Firebase project ID (optional if already embedded in the service account JSON)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional browser admin authentication (default: disabled)
# When enabled, Firebase Web Auth uses these public, non-secret settings.
ENABLE_FIREBASE_ADMIN_AUTH=false
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_firebase_project_id.firebaseio.com
FIREBASE_APP_ID=your_firebase_web_app_id
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
# Alternatively provide the public Firebase Web config as one JSON value.
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# --- Credential Option A: file path (good for local dev / VMs) ---
# Set this to the absolute path of your service account JSON key file.
# The firebase-admin SDK picks this up automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# --- Credential Option B: inline JSON (preferred for Render.com secret env vars) ---
# Paste the entire contents of your service account JSON key as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional server-side Firebase Remote Config tuning (Preview; fail-open)
# Loads the allow-listed operational parameters once at startup and on a bounded cadence.
ENABLE_FIREBASE_REMOTE_CONFIG=false
FIREBASE_REMOTE_CONFIG_REFRESH_INTERVAL_MS=900000
FIREBASE_REMOTE_CONFIG_LOAD_TIMEOUT_MS=10000
FIREBASE_REMOTE_CONFIG_MAX_AGE_MS=3600000
# Allow-listed keys: NEWS_ALERT_THRESHOLD, NEWS_TIMEOUT_MS, NEWS_GEMINI_CONCURRENCY,
# NEWS_GEMINI_QUOTA_MAX_RETRIES, NEWS_GEMINI_QUOTA_RETRY_BASE_MS,
# TRADINGVIEW_MCP_TIMEOUT_MS, TRADINGVIEW_MCP_MAX_RETRIES,
# TRADINGVIEW_MCP_ENRICHMENT_BUDGET_MS, TRADINGVIEW_MCP_BREAKER_FAILURE_THRESHOLD,
# TRADINGVIEW_MCP_BREAKER_COOLDOWN_MS, TRADINGVIEW_MCP_PAGE_COOLDOWN_MS,
# ENABLE_MESSAGE_FOOTER_METADATA, EXPANDED_ANALYSIS_ALERT_CONCURRENCY.
# Never place credentials, API keys, webhook auth, route/security gates, or chat IDs here.
# ============================================================================
