# ============================================================================
# Cabros Crypto Bot - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# See README.md for detailed configuration guide
# ============================================================================

# ============================================================================
# REQUIRED: Core Bot Configuration
# ============================================================================

# Telegram bot token (required only when ENABLE_TELEGRAM_BOT=true outside PR previews)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID where bot sends alerts (use /start to find your chat ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Enable Telegram bot (true or false)
ENABLE_TELEGRAM_BOT=true

# ============================================================================
# OPTIONAL: Security and API Authentication
# ============================================================================

# API Key to secure all /api endpoints (highly recommended in production).
# When configured, requests must include the header: x-api-key: your_key_here
# or the legacy query parameter: api-key=your_key_here
# WEBHOOK_API_KEY=your_webhook_api_key_here

# ============================================================================
# OPTIONAL: WhatsApp Alerts (GreenAPI Integration)
# ============================================================================

# Enable WhatsApp alerts (default: false)
ENABLE_WHATSAPP_ALERTS=false

# GreenAPI endpoint URL (e.g., https://xxxx.api.green-api.com/<instance-id>/)
WHATSAPP_API_URL=your_whatsapp_api_url

# GreenAPI API key for authentication
WHATSAPP_API_KEY=your_whatsapp_api_key

# WhatsApp chat/group ID (format: 120363xxxxx@g.us)
WHATSAPP_CHAT_ID=your_whatsapp_chat_id_here

# WhatsApp preview/PR chat/group ID (optional)
# When IS_PULL_REQUEST=true, messages are sent here instead of WHATSAPP_CHAT_ID
WHATSAPP_PREVIEW_CHAT_ID=your_whatsapp_preview_chat_id_here

# ============================================================================
# OPTIONAL: Discord Alerts (Webhook Integration)
# ============================================================================

# Enable Discord alerts (default: false)
ENABLE_DISCORD_ALERTS=false

# Discord webhook URL (e.g., https://discord.com/api/webhooks/<id>/<token>)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ============================================================================
# OPTIONAL: AI Grounding (Gemini GoogleSearch Enrichment)
# ============================================================================

# Enable Gemini-based alert enrichment (default: false)
ENABLE_GEMINI_GROUNDING=false

# Google API key with Generative AI enabled (get from Google AI Studio)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Primary provider used by grounding and secondary LLM enrichment.
# Supported values include gemini, azure, openrouter, and cloudflare.
MODEL_PROVIDER=gemini

# Primary Gemini model used when MODEL_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.5-flash

# Fallback Gemini model for transient primary-model failures
GEMINI_MODEL_NAME_FALLBACK=gemini-2.5-flash-lite

# Optional Brave Search fallback or forced-search provider
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
FORCE_BRAVE_SEARCH=false

# Optional OpenRouter provider credentials and model
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Enable model metadata footer in enriched alerts (default: true)
ENABLE_MESSAGE_FOOTER_METADATA=true

# ==========================================================================
# OPTIONAL: Langfuse Prompt Management
# ==========================================================================

# Fetch runtime prompts from Langfuse instead of local defaults (default: false)
ENABLE_LANGFUSE_PROMPTS=false

# Langfuse project credentials (required when ENABLE_LANGFUSE_PROMPTS=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse region or self-hosted base URL (default: https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Prompt label to fetch (default: latest in dev/test, production in prod-like envs)
LANGFUSE_PROMPT_LABEL=latest

# SDK cache TTL in seconds for prompt fetches (default: 0 for latest, 60 for production)
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=0

# ============================================================================
# OPTIONAL: TradingView MCP Enrichment (Webhook Signals)
# ============================================================================

# Enable MCP-based technical enrichment for TradingView-like alerts
# Example input: BTCUSDT(240) pasó a señal de VENTA
# Runtime note: request must include /api/webhook/alert?useTradingViewData=true
ENABLE_TRADINGVIEW_MCP_ENRICHMENT=false

# MCP server endpoint (Streamable HTTP)
TRADINGVIEW_MCP_URL=https://tradingview-mcp-yp6b.onrender.com/mcp

# Request timeout per MCP call in milliseconds
TRADINGVIEW_MCP_TIMEOUT_MS=12000

# Retry attempts for MCP calls
TRADINGVIEW_MCP_MAX_RETRIES=3

# Defaults used when signal does not include exchange/timeframe
TRADINGVIEW_MCP_DEFAULT_EXCHANGE=BINANCE
TRADINGVIEW_MCP_DEFAULT_TIMEFRAME=1h

# Enable volume breakout validation for TradingView alerts (default: false)
ENABLE_TRADINGVIEW_VOLUME_CONFIRMATION=false

# Enable combined_analysis confluence enrichment for TradingView webhook alerts (default: false)
ENABLE_TRADINGVIEW_CONFLUENCE_ENRICHMENT=false

# Also call multi_timeframe_analysis during confluence enrichment (default: false)
ENABLE_TRADINGVIEW_CONFLUENCE_MULTI_TIMEFRAME=false

# Fallback symbols for /api/webhook/expanded-analysis-alert using EXCHANGE:SYMBOL format (comma-separated)
# Example: BINANCE:BTCUSDT,NASDAQ:NVDA
EXPANDED_ANALYSIS_ALERT_SYMBOLS=BINANCE:BTCUSDT,NASDAQ:NVDA

# Total analysis deadline for /api/webhook/expanded-analysis-alert in milliseconds (default: 60000)
EXPANDED_ANALYSIS_ALERT_TIMEOUT_MS=60000

# ============================================================================
# OPTIONAL: Admin Notifications
# ============================================================================

# Chat ID for admin notifications and deployment alerts (optional)
TELEGRAM_ADMIN_NOTIFICATIONS_CHAT_ID=your_admin_chat_id_here

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================

# HTTP server port (default: 80)
PORT=80

# Maximum graceful shutdown budget in milliseconds (default: 10000, hard cap: 30000)
SHUTDOWN_TIMEOUT_MS=10000

# Log level for console output (debug, info, warn, error, silent)
# Defaults to debug in development and info in production
LOG_LEVEL=info

# Render.com deployment flag (set automatically by Render)
RENDER=false

# Trusted proxy configuration for Express rate limiting behind reverse proxies.
# Supported values: true (trust all), false (ignore X-Forwarded-For; direct deployment default),
# 1 (trust 1 hop; Render default when RENDER=true), or a subnet string (e.g., loopback, 10.0.0.0/8).
# TRUST_PROXY=1

# Render preview environment flag (set automatically by Render)
IS_PULL_REQUEST=false

# ============================================================================
# OPTIONAL: News Monitoring Feature (003-news-monitor)
# ============================================================================

# Enable news monitoring endpoint (default: false)
ENABLE_NEWS_MONITOR=false

# Enable news monitoring endpoint in test mode (default: false)
# In test mode, alerts are generated without real news data
ENABLE_NEWS_MONITOR_TEST_MODE=false

# Default crypto symbols if not provided in request (comma-separated)
# Example: BTCUSDT,ETHUSD,BNBUSDT
NEWS_SYMBOLS_CRYPTO=BTCUSDT,ETHUSD,BNBUSDT

# Default stock symbols if not provided in request (comma-separated)
# Example: NVDA,MSFT,AAPL
NEWS_SYMBOLS_STOCKS=NVDA,MSFT,AAPL

# Confidence score threshold for sending alerts (default: 0.7, range: 0.0-1.0)
# Alerts with confidence below this threshold are filtered out
NEWS_ALERT_THRESHOLD=0.7

# Cache time-to-live for deduplication (default: 6 hours)
# Same (symbol, event_category) pair within TTL will be cached
NEWS_CACHE_TTL_HOURS=6

# Per-symbol analysis timeout in milliseconds (default: 30000 ms)
# Each symbol has up to this long to complete analysis
NEWS_TIMEOUT_MS=30000

# Max concurrent Gemini-backed symbol analyses.
# Production policy: keep this bounded at 3 to reduce quota bursts.
# Unset preserves legacy full fan-out for backward compatibility.
NEWS_GEMINI_CONCURRENCY=3

# Per-symbol retries for Gemini 429 RESOURCE_EXHAUSTED errors (default: 2)
NEWS_GEMINI_QUOTA_MAX_RETRIES=2

# Base exponential backoff in ms when Gemini does not provide retry metadata (default: 1000)
NEWS_GEMINI_QUOTA_RETRY_BASE_MS=1000

# ============================================================================
# OPTIONAL: Binance Price Integration (News Monitoring)
# ============================================================================

# Enable Binance crypto price fetching (default: false)
# When enabled, fetches real-time prices from Binance API (~5s timeout)
# Falls back to Gemini GoogleSearch if Binance fails or times out
ENABLE_BINANCE_PRICE_CHECK=false

# ============================================================================
# OPTIONAL: Secondary LLM Enrichment (News Monitoring)
# ============================================================================

# Enable optional secondary LLM enrichment for news alerts (default: false)
# Refines confidence scores using conservative strategy: min(Gemini, LLM)
# Prevents false positives from LLM hallucination
ENABLE_LLM_ALERT_ENRICHMENT=false

# Azure AI Inference endpoint URL
# Example: https://models.github.ai/inference or https://your-azure-instance.inference.ai.azure.com
AZURE_LLM_ENDPOINT=your_azure_or_github_models_endpoint_here

# Azure AI Inference API key
# Use Azure API key or GitHub Personal Access Token (PAT)
AZURE_LLM_KEY=your_azure_api_key_or_github_pat_here

# Azure AI LLM model deployment name
# Example: openai/gpt-5-mini (GitHub Models) or gpt-4o (Azure)
AZURE_LLM_MODEL=your_model_name_here

# ============================================================================
# OPTIONAL: Cloudflare AI Gateway LLM Provider
# ============================================================================
# Replaces or supplements provider-specific clients with the OpenAI SDK
# pointed at Cloudflare AI Gateway's OpenAI-compatible endpoint.
# Set MODEL_PROVIDER=cloudflare to use this provider as the primary LLM.
#
# Cloudflare AI Gateway token (API key)
# CF_AIG_TOKEN=your_cloudflare_ai_gateway_token_here
#
# OpenAI-compatible base URL for Cloudflare AI Gateway
# CF_AIG_BASE_URL=https://gateway.ai.cloudflare.com/v1/your-account-tag/default/compat
#
# Default model served through the gateway (e.g., google-ai-studio/gemini-2.5-flash)
# CF_AIG_MODEL=google-ai-studio/gemini-2.5-flash

# ============================================================================
# URL Shortening for WhatsApp (Optional)
# ============================================================================
URL_SHORTENER_SERVICE=picsee
PICSEE_API_KEY=
CUTTLY_API_KEY=
# TinyURL does not require a credential.
# Bitly, reurl, and Pixnet0rz.tw are not supported by the runtime.

# ============================================================================
# OPTIONAL: TradingView Market Scanner Alerts
# ============================================================================

# Enable TradingView Market Scanner endpoint (default: false)
ENABLE_MARKET_SCANNER=false

# Default exchange when not provided in request
MARKET_SCANNER_DEFAULT_EXCHANGE=BINANCE

# Timeout in milliseconds for scanner webhook process (default: 90000, max: 120000)
MARKET_SCANNER_TIMEOUT_MS=90000

# Enable independent Firestore persistence for scanner presets (default: false)
# When disabled, presets use an in-memory fallback and do not survive restarts.
# The API and /api/status report the effective durable/ephemeral storage mode.
ENABLE_FIRESTORE_SCANNER_PRESETS=false

# ============================================================================
# Sentry Monitoring Configuration (Optional)
# ============================================================================
ENABLE_SENTRY=false # Enable Sentry error reporting (`true` or `false`, default: `false`)
SENTRY_DSN=your_sentry_dsn_here # Sentry Data Source Name (DSN) from your Sentry project settings
SENTRY_SEND_ALERT_CONTENT=true # Include alert text in error events (`true` or `false`, default: `true`)
SENTRY_SAMPLE_RATE_ERRORS=1.0 # Error sample rate from 0.0 to 1.0 (default: `1.0` = 100% of errors)
SENTRY_TRACES_SAMPLE_RATE=0.1 # Trace sample rate from 0.0 to 1.0 (leave empty/unset to disable tracing entirely)
SENTRY_PROFILE_SESSION_SAMPLE_RATE= # Profiling session sample rate from 0.0 to 1.0 (leave unset to disable profiling; requires SENTRY_TRACES_SAMPLE_RATE to be set)
SENTRY_CONSOLE_LOG_LEVELS=warn,error # Comma-separated console levels captured as Sentry Logs
SENTRY_ENVIRONMENT=development # Explicit environment tag (`production`, `preview`, `development`). Auto-derived if not set
SENTRY_RELEASE=local # Explicit release tag (e.g., `v1.2.3`). Auto-derived from git commit if not set
# ============================================================================

# ============================================================================
# OPTIONAL: Firestore Alert Storage (006-firestore-alert-storage)
# ============================================================================

# Enable storing every /api/webhook/alert payload in Cloud Firestore (default: false)
# When enabled, each alert is persisted to the `alerts` collection after delivery.
# Failure to write to Firestore never blocks or fails alert delivery (fail-open).
ENABLE_FIRESTORE_ALERT_STORAGE=false

# Enable storing async TradingView scanner/analysis jobs in Cloud Firestore (default: false)
# When enabled, job execution state is persisted to the `jobs` collection.
ENABLE_FIRESTORE_JOB_STORAGE=false

# Keep async jobs in-process (local) or enqueue them for the Render worker (render-worker).
# render-worker requires REDIS_URL and durable Firestore job storage.
JOB_EXECUTION_MODE=local
REDIS_URL=
JOB_QUEUE_ATTEMPTS=5
JOB_QUEUE_BACKOFF_MS=30000
JOB_QUEUE_CONCURRENCY=1
JOB_QUEUE_CLAIM_LEASE_MS=60000
JOB_QUEUE_CONNECT_TIMEOUT_MS=5000

# Enable durable webhook idempotency storage in Cloud Firestore (default: false)
# When enabled, idempotency reservations and cached responses are stored in `idempotency_keys` collection.
ENABLE_FIRESTORE_IDEMPOTENCY=false

# Enable shadow-mode signal outcome tracking (default: false)
# Legacy alias retained for one release; prefer ENABLE_SIGNAL_OUTCOME_TRACKING.
ENABLE_SHADOW_MODE_OUTCOME_TRACKING=false
ENABLE_SIGNAL_OUTCOME_TRACKING=false
# Scheduler role: web (legacy/local timer), worker (dedicated Render worker), or disabled.
SIGNAL_OUTCOME_WORKER_ROLE=web

# Optional Twelve Data evaluation for NASDAQ/BATS signal outcomes (default: false)
# Requires a provider API key; leave disabled until plan limits and market-data licensing are confirmed.
ENABLE_EQUITY_MARKET_DATA=false
EQUITY_MARKET_DATA_PROVIDER=twelve-data
TWELVE_DATA_API_KEY=your_twelve_data_api_key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
EQUITY_MARKET_DATA_TIMEOUT_MS=5000

# Signal Outcome Evaluation Worker Configuration
# Evaluation interval in milliseconds (default: 300000 / 5 minutes)
SIGNAL_OUTCOME_EVALUATION_INTERVAL_MS=300000
# Maximum pending signals to scan per evaluation sweep (default: 50)
SIGNAL_OUTCOME_EVALUATION_BATCH_LIMIT=50
# Maximum duration budget per evaluation sweep in milliseconds (default: 30000 / 30 seconds)
SIGNAL_OUTCOME_EVALUATION_MAX_DURATION_MS=30000

# Firebase project ID (optional if already embedded in the service account JSON)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional browser admin authentication (default: disabled)
# When enabled, Firebase Web Auth uses these public, non-secret settings.
ENABLE_FIREBASE_ADMIN_AUTH=false
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
FIREBASE_APP_ID=your_firebase_web_app_id
# Alternatively provide the public Firebase Web config as one JSON value.
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# --- Credential Option A: file path (good for local dev / VMs) ---
# Set this to the absolute path of your service account JSON key file.
# The firebase-admin SDK picks this up automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# --- Credential Option B: inline JSON (preferred for Render.com secret env vars) ---
# Paste the entire contents of your service account JSON key as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional server-side Firebase Remote Config tuning (Preview; fail-open)
# Loads the allow-listed operational parameters once at startup and on a bounded cadence.
ENABLE_FIREBASE_REMOTE_CONFIG=false
FIREBASE_REMOTE_CONFIG_REFRESH_INTERVAL_MS=900000
FIREBASE_REMOTE_CONFIG_LOAD_TIMEOUT_MS=10000
FIREBASE_REMOTE_CONFIG_MAX_AGE_MS=3600000
# Allow-listed keys: NEWS_ALERT_THRESHOLD, NEWS_TIMEOUT_MS, NEWS_GEMINI_CONCURRENCY,
# NEWS_GEMINI_QUOTA_MAX_RETRIES, NEWS_GEMINI_QUOTA_RETRY_BASE_MS,
# TRADINGVIEW_MCP_TIMEOUT_MS, TRADINGVIEW_MCP_MAX_RETRIES,
# TRADINGVIEW_MCP_ENRICHMENT_BUDGET_MS, ENABLE_MESSAGE_FOOTER_METADATA.
# Never place credentials, API keys, webhook auth, route/security gates, or chat IDs here.
# ============================================================================
