#!/usr/bin/env python3
"""
Script personalizado para generar señales de stock diario basado en la watchlist del usuario.
Obtiene RSI9, P/E, SMA50 y precios para los tickers en watchlist-stocks.md
y busca noticias de fallback para tickers en niveles técnicos interesantes.
"""

import os
import sys
import subprocess
import json
from datetime import datetime

# Añadir el skill de tradingview-screener al path
sys.path.insert(0, '/home/ubuntu/.openclaw/workspace/skills/tradingview-screener')

from tvscreener import StockScreener
from tvscreener.field.stock import StockField

def read_watchlist():
    """Lee la watchlist desde el archivo markdown"""
    watchlist_path = '/home/ubuntu/.openclaw/workspace/memory/watchlist-stocks.md'
    
    with open(watchlist_path, 'r') as f:
        content = f.read()
    
    # Extraer la sección de formato original TradingView
    lines = content.split('\n')
    watchlist_line = None
    for line in lines:
        if line.startswith('###STOCKS TECH'):
            watchlist_line = line
            break
    
    if not watchlist_line:
        # Fallback: extraer todos los tickers de las secciones
        import re
        # Buscar patrones como NASDAQ:TICKER o NYSE:TICKER
        tickers = re.findall(r'(NASDAQ|NYSE|BINANCE|FX_IDC):([A-Z0-9.]+)', content)
        return [f"{exchange}:{symbol}" for exchange, symbol in tickers]
    
    # Extraer todo después de ### hasta la siguiente ### o final
    start_idx = content.find('###STOCKS TECH')
    end_markers = ['###CHILE', '###OTROS', '###ENERGIA', '###DEFENSA', '###BERKSHIRE HATHAWAY', '###INDEXES', '###Crypto', '###FOREX']
    end_idx = len(content)
    for marker in end_markers:
        marker_idx = content.find(marker, start_idx)
        if marker_idx != -1 and marker_idx < end_idx:
            end_idx = marker_idx
    
    watchlist_section = content[start_idx:end_idx]
    # Extraer tickers del formato CSV
    import re
    tickers = re.findall(r'(NASDAQ|NYSE|BINANCE|FX_IDC):([A-Z0-9.]+)', watchlist_section)
    symbols = [f"{exchange}:{symbol}" for exchange, symbol in tickers]
    # Devolver solo el primer símbolo para probar
    return symbols[:1] if symbols else []

def get_stock_data(symbols):
    """Obtiene datos de los símbolos usando TradingView Screener"""
    try:
        # Usar el screener para obtener RSI9, SMA50, Precio y P/E
        # Nota: TradingView no tiene RSI9 directamente, usamos RSI14 como aproximación
        # y tenemos que hacer múltiples llamadas para diferentes campos
        
        # Primero obtener precio, cambio, RSI14 y SMA50
        screener = StockScreener()
        # Filtrar por los símbolos de nuestra watchlist
        # NOTA: Filtrado desactivado temporalmente para depuración
        # screener.where(StockField.NAME.isin(symbols))
        screener.select(
            StockField.NAME,
            StockField.PRICE,
            StockField.CHANGE_PERCENT,
            StockField.RELATIVE_STRENGTH_INDEX_14,  # RSI14 (más cercano a RSI9 que tenemos)
            StockField.SIMPLE_MOVING_AVERAGE_50,
            StockField.EARNINGS_PER_SHARE_BASIC_TTM  # Para calcular P/E aproximado
        )
        # Establecer timeframe diario para los indicadores técnicos
        # Nota: El timeframe se maneja automáticamente o no es necesario especificar para estos campos
        
        # Ejecutar el screener
        result = screener.get()
        
        if result is None or len(result) == 0:
            return []
        
        # Convertir a lista de diccionarios
        stocks = []
        for _, row in result.iterrows():
            stock_data = {
                'symbol': row.get('NAME', ''),
                'price': row.get('PRICE', 0),
                'change_percent': row.get('CHANGE_PERCENT', 0),
                'rsi': row.get('RELATIVE_STRENGTH_INDEX_14', 0),  # Usando RSI14
                'sma50': row.get('SIMPLE_MOVING_AVERAGE_50', 0),
                'eps': row.get('EARNINGS_PER_SHARE_BASIC_TTM', 0)
            }
            # Calcular P/E aproximado si tenemos EPS y precio
            if stock_data['eps'] != 0 and stock_data['price'] != 0:
                stock_data['pe_ratio'] = stock_data['price'] / stock_data['eps']
            else:
                stock_data['pe_ratio'] = None
                
            stocks.append(stock_data)
        
        return stocks
        
    except Exception as e:
        print(f"Error obteniendo datos de TradingView: {e}")
        return []

def search_fallback_news(tickers):
    """Busca noticias de fallback usando el script proporcionado"""
    try:
        script_path = '/home/ubuntu/.openclaw/workspace/scripts/search_fallback_curl.sh'
        if os.path.exists(script_path):
            # Ejecutar el script de búsqueda con fallback
            result = subprocess.run(
                ['bash', script_path] + tickers[:10],  # Limitar a 10 tickers para evitar timeout
                capture_output=True,
                text=True,
                timeout=60
            )
            return result.stdout if result.returncode == 0 else result.stderr
        else:
            # Si no existe el script, hacer una búsqueda básica usando web_search
            # Esta sería una implementación simplificada
            return "Script de búsqueda de fallback no encontrado"
    except Exception as e:
        return f"Error en búsqueda de fallback: {e}"

def format_report(stocks_data):
    """Formatea el reporte exactamente como le gusta al usuario"""
    if not stocks_data:
        return "No se pudieron obtener datos de las acciones en la watchlist."
    
    # Clasificar stocks por RSI
    extreme_oversold = [s for s in stocks_data if s['rsi'] < 25]
    oversold = [s for s in stocks_data if 25 <= s['rsi'] < 35]
    neutral = [s for s in stocks_data if 35 <= s['rsi'] <= 65]
    overbought = [s for s in stocks_data if s['rsi'] > 70]
    
    # Ordenar cada categoría por RSI (ascendente para oversold, descendente para overbought)
    extreme_oversold.sort(key=lambda x: x['rsi'])
    oversold.sort(key=lambda x: x['rsi'])
    neutral.sort(key=lambda x: x['rsi'])
    overbought.sort(key=lambda x: x['rsi'], reverse=True)
    
    # Obtener fecha actual en zona de Chile
    ahora = datetime.now()
    dia_semana = ahora.strftime('%A')
    fecha = ahora.strftime('%d de %B de %Y')
    # Traducir al español
    dias_semana = {
        'Monday': 'Lunes',
        'Tuesday': 'Martes', 
        'Wednesday': 'Miércoles',
        'Thursday': 'Jueves',
        'Friday': 'Viernes',
        'Saturday': 'Sábado',
        'Sunday': 'Domingo'
    }
    meses = {
        'January': 'enero',
        'February': 'febrero',
        'March': 'marzo',
        'April': 'abril',
        'May': 'mayo',
        'June': 'junio',
        'July': 'julio',
        'August': 'agosto',
        'September': 'septiembre',
        'October': 'octubre',
        'November': 'noviembre',
        'December': 'diciembre'
    }
    dia_semana_es = dias_semana.get(dia_semana, dia_semana)
    for eng, esp in meses.items():
        fecha = fecha.replace(eng, esp)
    
    report = f"---\n📊 *ANÁLISIS AMPLIADO — {dia_semana_es} {fecha}*\n\n"
    
    # SOBRESVENDIDOS EXTREMOS — COMPRA! (RSI < 25)
    report += "*🔴 SOBRESVENDIDOS EXTREMOS — COMPRA!* (RSI < 25)\n"
    if extreme_oversold:
        for stock in extreme_oversold[:5]:  # Máximo 5 para no hacerlo muy largo
            pe_text = f"P/E {stock['pe_ratio']:.1f}" if stock['pe_ratio'] else "P/E N/A"
            report += f"{stock['symbol']} ${stock['price']:.2f} ({stock['change_percent']:+.1f}%) | RSI {stock['rsi']:.1f}\n"
            report += f"- {pe_text}\n"
            if stock['sma50'] > 0:
                report += f"- SMA50: ${stock['sma50']:.2f}\n"
            report += "- *Fundamento:* RSI indica condiciones de sobreventa extrema\n"
            report += "- *Recomendación:* Considerar compra escalonada, soporta en SMA200 si está disponible\n\n"
    else:
        report += "No hay acciones en sobreventa extrema en la watchlist actualmente.\n\n"
    
    # SOBRESVENDIDOS — CONSIDERAR COMPRA (RSI 25-35)
    report += "*⚠️ SOBRESVENDIDOS — CONSIDERAR COMPRA* (RSI 25-35)\n"
    if oversold:
        for stock in oversold[:5]:
            pe_text = f"P/E {stock['pe_ratio']:.1f}" if stock['pe_ratio'] else "P/E N/A"
            report += f"{stock['symbol']} ${stock['price']:.2f} ({stock['change_percent']:+.1f}%) | RSI {stock['rsi']:.1f}\n"
            report += f"- {pe_text}\n"
            if stock['sma50'] > 0:
                report += f"- Precio vs SMA50: {'+' if stock['price'] > stock['sma50'] else '-'}{abs((stock['price'] - stock['sma50']) / stock['sma50'] * 100):.1f}%\n"
            report += "- *Fundamento:* RSI en zona de sobreventa, buscar señales de recuperación\n"
            report += "- *Recomendación:* Evaluar entrada en debilidad, buscar convalidación de volumen\n\n"
    else:
        report += "No hay acciones en sobreventa moderada en la watchlist actualmente.\n\n"
    
    # NEUTROS / HOLD — MANTENER (RSI 35-65)
    report += "*🟡 NEUTROS / HOLD — MANTENER* (RSI 35-65)\n"
    if neutral:
        # Mostrar los 5 más relevantes (cerca de los extremos)
        relevant_neutral = sorted(neutral, key=lambda x: abs(x['rsi'] - 50))[:5]
        for stock in relevant_neutral:
            pe_text = f"P/E {stock['pe_ratio']:.1f}" if stock['pe_ratio'] else "P/E N/A"
            report += f"- {stock['symbol']}: ${stock['price']:.2f} ({stock['change_percent']:+.1f}%) | RSI {stock['rsi']:.1f} | {pe_text}\n"
    else:
        report += "- No hay acciones en zona neutral en la watchlist actualmente.\n"
    report += "\n"
    
    # SOBRECOMPRADOS — TOMA DE GANANCIAS (RSI > 70)
    report += "*🔴 SOBRECOMPRADOS — TOMA DE GANANCIAS* (RSI > 70)\n"
    if overbought:
        for stock in overbought[:5]:
            pe_text = f"P/E {stock['pe_ratio']:.1f}" if stock['pe_ratio'] else "P/E N/A"
            report += f"- {stock['symbol']} - ${stock['price']:.2f} - RSI {stock['rsi']:.1f} - {pe_text}\n"
    else:
        report += "- No hay acciones en sobrecompra en la watchlist actualmente.\n"
    report += "\n"
    
    # RESUMEN
    report += "*=== RESUMEN ===\n"
    total_stocks = len(stocks_data)
    oversold_count = len(extreme_oversold) + len(oversold)
    overbought_count = len(overbought)
    neutral_count = len(neutral)
    
    report += f"Análisis de {total_stocks} acciones de la watchlist: "
    report += f"{oversold_count} en sobreventa ({len(extreme_oversold)} extrema), "
    report += f"{neutral_count} neutrales, {overbought_count} en sobrecompra. "
    
    if extreme_oversold:
        report += "Oportunidades de compra en sobreventa extrema identificadas. "
    if overbought_count > 3:
        report += "Considerar toma de ganancias en posiciones sobrecompradas. "
    report += "Mantener posiciones neutrales con stops apropiados.\n"
    report += "---\n"
    
    return report

def main():
    print("Leyendo watchlist...")
    watchlist = read_watchlist()
    print(f"Watchlist cargada: {len(watchlist)} símbolos")
    
    if not watchlist:
        print("Error: No se pudo leer la watchlist")
        return
    
    print("Obteniendo datos de TradingView...")
    stocks_data = get_stock_data(watchlist[:50])  # Limitar a 50 para evitar límites de API
    print(f"Datos obtenidos para {len(stocks_data)} acciones")
    
    if not stocks_data:
        print("Error: No se pudieron obtener datos de TradingView")
        # Intentar con menos símbolos
        stocks_data = get_stock_data(watchlist[:20])
        if not stocks_data:
            print("Error crítico: No se pudieron obtener datos incluso con menos símbolos")
            return
    
    print("Generando reporte...")
    report = format_report(stocks_data)
    print(report)

if __name__ == "__main__":
    main()