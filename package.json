{
  "name": "cabros-bot",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build:hosting": "node scripts/build-hosting.js",
    "deploy:firebase-remote-config:server": "node scripts/deploy-server-remote-config.js",
    "sync:production-env": "node scripts/sync-production-env.js",
    "preinstall": "npx only-allow pnpm",
    "start": "node index.js",
    "start-worker": "node worker.js",
    "start:signal-outcome-worker": "node src/workers/signalOutcomeWorker.js",
    "start-dev": "nodemon index.js",
    "test": "jest --detectOpenHandles",
    "test:firebase": "env -u FIREBASE_SERVICE_ACCOUNT_JSON -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_APPLICATION_CREDENTIALS_JSON -u FIREBASE_CONFIG FIREBASE_PROJECT_ID=demo-cabros GCLOUD_PROJECT=demo-cabros FIRESTORE_EMULATOR_HOST=127.0.0.1:8081 firebase emulators:exec --project demo-cabros --config firebase.json --only firestore \"pnpm exec jest --config jest.firebase.config.js --runInBand\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@langfuse/client": "^5.0.1",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.70.0",
    "binance": "^2.10.2",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "express-healthcheck": "^0.1.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "openai": "^4.104.0",
    "swagger-ui-dist": "^5.32.6",
    "telegraf": "^4.3.0",
    "undici": "6.28.0",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "@azure-rest/ai-inference": "^1.0.0-beta.6",
    "@azure/core-auth": "^1.10.1",
    "@azure/core-sse": "^2.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "firebase": "12.17.0",
    "firebase-tools": "15.25.1",
    "globals": "^17.6.0",
    "jest": "^30.2.0",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^2.0.7",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4"
  }
}
